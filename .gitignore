/bin/

# Issue 11 local-only capture fixtures, incomplete runs, and review scratch.
/.runtime-issue11-authenticated-cdp-input/
/.runtime-issue11-authenticated-cdp-run/
/.runtime-issue11-cdp-fixture/
/.runtime-issue11-cdp-nonplacement-fixture/
/.runtime-issue11-cdp-nonplacement-run/
/.runtime-issue11-cdp-run/
/.runtime-issue11-run/
/tmp/

# Keep the completed authenticated run's durable invocation records, but not
# raw provider/agent output logs.
/.runtime-issue11-authenticated-cdp-completed-run/.control/logs/

# Raw agent transcripts from a smoke run. The prompts, provider stdout/stderr,
# and exit markers are reproducible per-invocation detail, not review evidence.
# The durable per-invocation profile record under .control/invocations/ is kept.
/smoke-runs/*/.control/logs/
/smoke-runs/*/.control/prompts/
/smoke-runs/*/.control/exits/

# Ephemeral review inputs and specialist lens reports. Only the manager-level
# summary is durable enough to keep reviewable.
/docs/review/*
!/docs/review/manager*.md
